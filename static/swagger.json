
{
  "swagger": "2.0",
  "info": {
    "title": "Turkish Financial Data API",
    "description": "API for retrieving Turkish financial market data from fintables.com/radar",
    "version": "1.0.0"
  },
  "basePath": "/",
  "schemes": ["http", "https"],
  "paths": {
    "/api/data": {
      "get": {
        "summary": "Get all stock data",
        "description": "Returns all financial data collected from the last scraping",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {"type": "integer"},
                      "symbol": {"type": "string"},
                      "name": {"type": "string"},
                      "price": {"type": "string"},
                      "timestamp": {"type": "string", "format": "date-time"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/getBulkDataByNames": {
      "get": {
        "summary": "Get multiple stocks by names/symbols",
        "description": "Returns multiple financial data items by comma-separated names/symbols provided as a query parameter",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "names",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Comma-separated list of stock names or symbols (e.g., AKBNK,GARAN,ISCTR)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {"type": "integer"},
                      "symbol": {"type": "string"},
                      "name": {"type": "string"},
                      "price": {"type": "string"},
                      "timestamp": {"type": "string", "format": "date-time"}
                    }
                  }
                },
                "count": {"type": "integer"},
                "requested": {"type": "integer"},
                "missing": {"type": "integer"}
              }
            }
          },
          "400": {
            "description": "No names provided",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "message": {"type": "string"}
              }
            }
          }
        }
      },
      "post": {
        "summary": "Get multiple stocks by names/symbols (JSON body)",
        "description": "Returns multiple financial data items by names/symbols provided in request body",
        "produces": ["application/json"],
        "consumes": ["application/json"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "symbols": {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "List of stock names or symbols"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "symbol": {"type": "string"},
                      "name": {"type": "string"},
                      "price": {"type": "string"}
                    }
                  }
                },
                "count": {"type": "integer"}
              }
            }
          },
          "400": {
            "description": "No symbols provided",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "message": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "/api/data/{id}": {
      "get": {
        "summary": "Get stock data by ID",
        "description": "Returns a specific financial data item by its ID",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Stock ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "data": {
                  "type": "object",
                  "properties": {
                    "id": {"type": "integer"},
                    "symbol": {"type": "string"},
                    "name": {"type": "string"},
                    "price": {"type": "string"},
                    "timestamp": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Item not found",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "message": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "/api/stock/{name}": {
      "get": {
        "summary": "Get stock data by name or symbol",
        "description": "Returns a specific financial data item by its name or symbol",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Stock name or symbol"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "data": {
                  "type": "object",
                  "properties": {
                    "id": {"type": "integer"},
                    "symbol": {"type": "string"},
                    "name": {"type": "string"},
                    "price": {"type": "string"},
                    "timestamp": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Item not found",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "message": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "/api/getDataByName/{name}": {
      "get": {
        "summary": "Get stock data by name or symbol (explicit API)",
        "description": "Returns a specific financial data item by its name or symbol (case insensitive)",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Stock name or symbol"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "data": {
                  "type": "object",
                  "properties": {
                    "id": {"type": "integer"},
                    "symbol": {"type": "string"},
                    "name": {"type": "string"},
                    "price": {"type": "string"},
                    "timestamp": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Item not found",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "message": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "/api/force-update": {
      "get": {
        "summary": "Force data update",
        "description": "Triggers an immediate data update from the source website",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "message": {"type": "string"},
                "count": {"type": "integer"}
              }
            }
          }
        }
      },
      "post": {
        "summary": "Force data update",
        "description": "Triggers an immediate data update from the source website",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "message": {"type": "string"},
                "count": {"type": "integer"}
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Get system status",
        "description": "Returns information about the system status and last update time",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string"},
                "data": {
                  "type": "object",
                  "properties": {
                    "last_update": {"type": "string", "format": "date-time"},
                    "is_running": {"type": "boolean"},
                    "next_update": {"type": "string", "format": "date-time"},
                    "data_count": {"type": "integer"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
